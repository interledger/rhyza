{
  "name": "open-payments-auth-service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "build": "tsc --build",
    "test": "node --import tsx --test test/*.test.ts",
    "generate:types": "openapi-typescript ../../open-payments-specifications/openapi/auth-server.yaml --output src/types/generated/auth-server-types.ts",
    "prebuild": "pnpm generate:types"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/session": "^11.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "auth-client-lib": "workspace:*",
    "fastify": "~5.3.3",
    "implementations-lib": "workspace:*"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "tsx": "^4.19.3"
  }
}
