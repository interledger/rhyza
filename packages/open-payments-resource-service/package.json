{
  "name": "open-payments-resource-service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "build": "tsc --build",
    "test": "node --import tsx --test test/*.test.ts",
    "generate:resource-server-types": "openapi-typescript ../../open-payments-specifications/openapi/resource-server.yaml --output src/types/generated/resource-server-types.ts",
    "generate:wallet-address-server-types": "openapi-typescript ../../open-payments-specifications/openapi/wallet-address-server.yaml --output src/types/generated/wallet-address-server-types.ts",
    "generate:types": "pnpm generate:resource-server-types && pnpm generate:wallet-address-server-types",
    "prebuild": "pnpm generate:types"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "~5.3.3",
    "ilp-client-lib": "workspace:*",
    "pal-client-lib": "workspace:*",
    "payments-client-lib": "workspace:*",
    "implementations-lib": "workspace:*"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "tsx": "^4.19.3"
  }
}
