{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.23.4 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write . && eslint --max-warnings=0 --fix .",
    "lint": "prettier --check . && eslint --max-warnings=0 .",
    "lint:openapi": "redocly lint openapi/* --lint-config error --format=stylish",
    "generate:json": "redocly bundle openapi/admin/admin-api.yaml --output ./json/admin-api.json"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/starlight": "^0.43.1",
    "@interledger/docs-design-system": "^0.15.0",
    "@scalar/api-reference": "^1.83.0",
    "astro": "^7.4.13",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0",
    "satteri": "^0.10.3",
    "starlight-fullview-mode": "^0.2.6",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.31.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.11",
    "@typescript-eslint/parser": "^8.74.0",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "openapi-types": "^12.1.3",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript-eslint": "^8.74.0"
  }
}
