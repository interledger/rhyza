meta {
  name: Create Quote
  type: http
  seq: 5
}

post {
  url: http://{{openPaymentsResourceServerUrl}}/quotes
  body: json
  auth: none
}

body:json {
  {
    "walletAddress": "https://test.com/sender",
    "receiver": "http://open-payments-resource-service:3002/incoming-payments/{{incomingPaymentId}}",
    "method": "ilp",
    "debitAmount": {
      "assetScale": 2,
      "assetCode": "USD",
      "value": "1000"
    }
  }
}

script:post-response {
  const body = res.getBody();
  
  if (body?.id) {
    bru.setVar("quoteId", body.id);
  }
}
