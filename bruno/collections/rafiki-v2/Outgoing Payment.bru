meta {
  name: Outgoing Payment
  type: http
  seq: 7
}

post {
  url: http://{{baseUrl}}/payments
  body: json
  auth: none
}

body:json {
  {
    "walletAddress": "https://test.com/sender",
    "paymentIntentId": "{{paymentIntentId}}",
    "quoteId": "{{quoteId}}"
  }
}

script:post-response {
  const body = res.getBody();

  if (body?.id) {
    bru.setVar("paymentId", body.id);
  }
}
