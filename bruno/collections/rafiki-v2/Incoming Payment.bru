meta {
  name: Create Payment Intent
  type: http
  seq: 5
}

post {
  url: http://{{baseUrl}}/payment-intents
  body: json
  auth: none
}

body:json {
  {
    "walletAddress": "test.com/receiver",
    "incomingAmount": 100
  }
}

script:post-response {
  const body = res.getBody();

  if (body?.id) {
    bru.setVar("paymentIntentId", body.id);
  }
}
