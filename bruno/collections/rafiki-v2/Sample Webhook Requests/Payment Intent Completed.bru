meta {
  name: Payment Intent Completed
  type: http
  seq: 2
}

post {
  url: {{webhookUrl}}
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{$randomUUID}}",
    "type": "payment_intent.completed",
    "data": {
      "id": "{{$randomUUID}}",
      "walletAddressId": "{{$randomUUID}}",
      "createdAt": "{{now}}",
      "expiresAt": "{{tomorrow}}",
      "incomingAmount": {
        "value": 100,
        "assetCode": "USD",
        "assetScale": 1
      },
      "receiveAmount": {
        "value": 100,
        "assetCode": "USD",
        "assetScale": 1
      },
      "state": "CREATED"
    }
  }
}

script:pre-request {
  bru.setVar("now", new Date().toISOString())
  bru.setVar("tomorrow", (new Date(new Date().setDate(new Date().getDate() + 1))).toISOString());
  
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
