meta {
  name: Register Wallet Address Key
  type: http
  seq: 5
}

post {
  url: http://{{adminApiUrl}}/wallet-addresses/{{senderWalletAddressId}}/keys
  body: json
  auth: inherit
}

script:pre-request {
  const scripts = require('./scripts');
  
  if (!bru.getVar('clientPublicJwk')) {
    scripts.generateClientKeys();
  }
  
  req.setBody(JSON.parse(bru.getVar('clientPublicJwk')));
}

script:post-response {
  const body = res.getBody();
  
  if (body?.id) {
    bru.setVar("walletAddressKeyId", body.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
