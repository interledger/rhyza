meta {
  name: Create Sender Wallet Address
  type: http
  seq: 2
}

post {
  url: http://{{adminApiUrl}}/wallet-addresses
  body: json
  auth: inherit
}

body:json {
  {
    "assetCode": "USD",
    "pathName": "sender",
    "publicName": "test sender"
  }
}

script:post-response {
  const body = res.getBody();
  
  if (body?.address) {
    bru.setVar("senderWalletAddress", body.address);
  }
  if (body?.id) {
    bru.setVar("senderWalletAddressId", body.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
