meta {
  name: Create Outgoing Payment
  type: http
  seq: 12
}

post {
  url: http://{{openPaymentsResourceServerUrl}}/outgoing-payments
  body: json
  auth: none
}

headers {
  Authorization: GNAP {{outgoingPaymentAccessToken}}
}

body:json {
  {
    "walletAddress": "{{senderWalletAddressUrl}}",
    "quoteId": "{{quoteId}}"
  }
}

script:pre-request {
  const scripts = require('./scripts');

  await scripts.addSignatureHeaders();
}

script:post-response {
  const body = res.getBody();
  if (body?.id) {
    bru.setVar("outgoingPaymentId", body.id.split("/").pop());
  }
}

tests {
  test("created", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
