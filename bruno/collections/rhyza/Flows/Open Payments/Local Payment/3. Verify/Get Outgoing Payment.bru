meta {
  name: Get Outgoing Payment
  type: http
  seq: 2
}

get {
  url: http://{{openPaymentsResourceServerUrl}}/outgoing-payments/{{outgoingPaymentId}}
  body: none
  auth: none
}

headers {
  Authorization: GNAP {{outgoingPaymentAccessToken}}
}

script:pre-request {
  const scripts = require('./scripts');

  await scripts.addSignatureHeaders();
}

tests {
  test("sent the full debit amount", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.failed).to.equal(false);
    expect(body.sentAmount).to.deep.equal(body.debitAmount);
  });
}

docs {
  Read with the outgoing payment grant's token. Expect `failed: false` and
  `sentAmount` equal to `debitAmount`.

  The payment settles asynchronously, so straight after Create Outgoing
  Payment `sentAmount` may still be short. Send this again until it isn't.
}
