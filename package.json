{
  "name": "rafiki-v2",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "checks": "pnpm check:lint && pnpm check:format",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "docker": "docker compose -f ./docker/docker-compose.yaml",
    "docker:up": "docker compose -f ./docker/docker-compose.yaml down --volumes && docker compose -f ./docker/docker-compose.yaml up --build -d",
    "docker:up:debug": "docker compose -f ./docker/docker-compose.yaml -f ./docker/docker-compose.debug.yaml down --volumes && docker compose -f ./docker/docker-compose.yaml -f ./docker/docker-compose.debug.yaml up --build -d",
    "docker:stop": "docker compose -f ./docker/docker-compose.yaml down",
    "docker:down": "docker compose -f ./docker/docker-compose.yaml down --volumes",
    "docker:clean": "docker compose -f ./docker/docker-compose.yaml down --volumes --rmi all",
    "build": "pnpm -r  build",
    "format": "prettier --write .",
    "test": "pnpm -r test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.11",
    "eslint": "^9.39.2",
    "pino-pretty": "~13.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "grpc-tools",
      "@confluentinc/kafka-javascript",
      "protobufjs"
    ]
  }
}
