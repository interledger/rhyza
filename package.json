{
  "name": "rafiki-poc",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "docker": "docker compose -f ./docker/docker-compose.yaml",
    "docker:up": "docker compose -f ./docker/docker-compose.yaml down --volumes && docker compose -f ./docker/docker-compose.yaml up --build -d",
    "build": "pnpm -r  build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "pnpm -r test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.11",
    "eslint": "^9.39.2",
    "pino-pretty": "~13.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "grpc-tools",
      "node-rdkafka",
      "protobufjs"
    ]
  }
}
